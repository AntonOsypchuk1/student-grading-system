<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SGS.Domain\SGS.Domain.csproj"/>
        <ProjectReference Include="..\SGS.DbContext\SGS.DbContext.csproj" />
        <ProjectReference Include="..\SGS.SemanticAnalysis.Client\SGS.SemanticAnalysis.Client.csproj" />
<!--        <ProjectReference Include="..\SGS.SemanticAnalysis\SGS.SemanticAnalysis.csproj" />-->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper"/>
        <PackageReference Include="Azure.Storage.Blobs" />
        <PackageReference Include="BCrypt.Net-Next"/>
        <PackageReference Include="itext7" />
        <PackageReference Include="DocumentFormat.OpenXml" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Localization" />
        <PackageReference Include="TesseractOCR" />
    </ItemGroup>

    <ItemGroup>
        <None Update="tessdata/**/*.traineddata"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\EvaluationFormatter.en.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>EvaluationFormatter.en.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\EvaluationFormatter.en.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>EvaluationFormatter.en.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
