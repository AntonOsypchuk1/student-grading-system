<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SGS.Domain\SGS.Domain.csproj"/>
        <ProjectReference Include="..\SGS.Infrastructure\SGS.Infrastructure.csproj"/>
        <ProjectReference Include="..\SGS.SemanticAnalysis\SGS.SemanticAnalysis.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="14.0.0"/>
        <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3"/>
        <PackageReference Include="itext7" Version="9.1.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0-preview.3.25171.5" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.3" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\EvaluationFormatter.en.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>EvaluationFormatter.en.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\EvaluationFormatter.en.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>EvaluationFormatter.en.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
